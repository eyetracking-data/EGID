# Copy this file to .env and replace the placeholders with local paths.
# The file is ignored by Git and is loaded automatically by the notebooks.
# Point to the external Eye-Tracking data root that directly contains raw/.
# Keep all raw data outside this repository.
BENCHMARK_DATA_DIR="/absolute/path/to/local-data/eyetracking"
EYE_TRACKING_BENCHMARK_DIR="/absolute/path/to/benchmark-output"
EYE_TRACKING_LODO_RESULTS_DIR="/absolute/path/to/lodo-results"
EYE_TRACKING_ARTIFACT_DIR="/absolute/path/to/final-selector-artifact"
WEATHER_DATA_DIR="/absolute/path/to/local-data/weather"
WEATHER_BENCHMARK_DIR="/absolute/path/to/weather-benchmark-output"
WEATHER_LODO_RESULTS_DIR="/absolute/path/to/weather-lodo-results"
WEATHER_ARTIFACT_DIR="/absolute/path/to/weather-final-selector-artifact"
TRAFFIC_DATA_DIR="/absolute/path/to/local-data/traffic"
TRAFFIC_BENCHMARK_DIR="/absolute/path/to/traffic-benchmark-output"
TRAFFIC_LODO_RESULTS_DIR="/absolute/path/to/traffic-lodo-results"
TRAFFIC_ARTIFACT_DIR="/absolute/path/to/traffic-final-selector-artifact"
